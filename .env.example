# FlowForge Firebase Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env to version control!

# Platform API Keys
FIREBASE_WEB_API_KEY=your_web_api_key_here
FIREBASE_ANDROID_API_KEY=your_android_api_key_here
FIREBASE_IOS_API_KEY=your_ios_api_key_here
FIREBASE_MACOS_API_KEY=your_macos_api_key_here
FIREBASE_WINDOWS_API_KEY=your_windows_api_key_here

# Fallback generic API key
API=your_default_api_key_here

# App IDs
FIREBASE_WEB_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_IOS_APP_ID=1:000000000000:ios:0000000000000000000000
FIREBASE_MACOS_APP_ID=1:000000000000:ios:0000000000000000000000
FIREBASE_WINDOWS_APP_ID=1:000000000000:web:0000000000000000000000

# Firebase Project Details
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_WEB_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_WINDOWS_MEASUREMENT_ID=G-XXXXXXXXXX

